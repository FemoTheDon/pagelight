{
  "name": "PageLight",
  "short_name": "PageLight",
  "description": "EPUB, PDF and MOBI reader with focus and night modes, by Breadbaskets.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141414",
  "theme_color": "#141414",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/x-mobipocket-ebook": [
          ".mobi",
          ".azw",
          ".prc",
          ".kf8"
        ],
        "application/vnd.amazon.ebook": [
          ".azw3"
        ],
        "application/x-fictionbook+xml": [
          ".fb2",
          ".fbz"
        ],
        "application/vnd.comicbook+zip": [
          ".cbz"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}